\begin{tikzpicture}
  \begin{axis}[
      title={Beispielhafter Verlauf der Modellgenauigkeit},
      xlabel={Epochen},
      ylabel={Genauigkeit in \%},
      xmin=0, xmax=50,
      ymin=50, ymax=100,
      xtick={0,10,20,30,40,50},
      ytick={50,60,70,80,90,100},
      legend pos=south east,
      ymajorgrids=true,
      grid style=dashed,
  ]
  
  \addplot[
      color=blue,
      mark=square,
      ]
      coordinates {
      (0,55)(10,65)(20,78)(30,85)(40,92)(50,95)
      };
      \addlegendentry{Trainingsdaten}
      
  \addplot[
      color=red,
      mark=*,
      ]
      coordinates {
      (0,52)(10,60)(20,70)(30,78)(40,85)(50,86)
      };
