% ========================================
% PLATZHALTER FÜR NOCH NICHT ERZEUGTE ABBILDUNGEN
% ========================================
% Bewusst auffällig gesetzt, damit im fertigen PDF sofort sichtbar ist,
% welche Belege noch fehlen. Argument: Beschreibung des geplanten Inhalts.
% Verwendung wie \includegraphics, also innerhalb einer figure-Umgebung.
\newcommand{\platzhalterbild}[2][0.8\linewidth]{%
  \setlength{\fboxrule}{1pt}%
  \textcolor{hka_red}{\fbox{%
    \parbox[c][3.2cm][c]{#1}{%
      \centering\normalfont\color{black}%
      \textcolor{hka_red}{\textbf{Platzhalter -- Abbildung noch zu erzeugen}}\\[0.3em]
      \small #2%
    }%
  }}%
}

